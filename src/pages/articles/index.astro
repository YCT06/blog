---
import Layout from "../../layouts/Layout.astro";
import PageIntro from "../../components/site/PageIntro.astro";
import CategoryNav from "../../components/taxonomy/CategoryNav.astro";
import ArticleList from "../../components/articles/ArticleList.astro";
import { listArticles } from "../../lib/articles";
const articles = await listArticles();
---

<Layout title="所有文章"
  ><main id="main-content" tabindex="-1" class="archive-page">
    <PageIntro
      title="所有筆記，依脈絡累積。"
      eyebrow="文章總覽"
      description="依分類瀏覽，再用標籤串起跨領域內容。"
      articles={articles}
    />
    <CategoryNav /><ArticleList articles={articles} />
  </main></Layout
>
<style>
  .archive-page {
    padding-top: 28px;
  }
  @media (max-width: 760px) {
    .archive-page {
      padding-top: 20px;
    }
  }
</style>
