---
import { render, type CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import TableOfContents from "../../components/articles/TableOfContents.astro";
import { listArticles } from "../../lib/articles";
import { dateLabel, categoryOgImages } from "../../lib/presentation";
import { CATEGORY_LABELS, TAG_LABELS } from "../../data/taxonomy";
import "../../styles/prose.css";
export async function getStaticPaths() {
  return (await listArticles()).map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}
interface Props {
  article: CollectionEntry<"articles">;
}
const { article } = Astro.props;
const { Content, headings } = await render(article);
const { title, description, pubDate, updatedDate, category, tags, cover } =
  article.data;
const hasToc = headings.some((h) => h.depth === 2 || h.depth === 3);
const ogImage = cover
  ? (await getImage({ src: cover.src, width: 1200 })).src
  : categoryOgImages[category];
---

<Layout title={title} description={description} image={ogImage} type="article">
  <main id="main-content" tabindex="-1">
    <article class="reading-article">
      <a class="text-link" href="/articles/">← 回到文章總覽</a>
      <header class="article-head" data-pagefind-body>
        <p class="eyebrow">
          <a
            href={`/categories/${category}/`}
            data-pagefind-meta="category, categoryHref[href]"
            >{CATEGORY_LABELS[category]}</a
          > · <time
            datetime={dateLabel(pubDate)}
            data-pagefind-meta="date"
            >{dateLabel(pubDate).replaceAll("-", ".")}</time>
        </p>
        <h1 data-pagefind-meta="title">{title}</h1><p
          class="standfirst"
          data-pagefind-meta="description">{description}</p>
        {
          (tags.length > 0 || updatedDate) && (
            <div
              class="tag-row"
              data-pagefind-meta={
                tags.length > 0
                  ? `tags:${tags.map((tag) => TAG_LABELS[tag]).join("、")}`
                  : undefined
              }
            >
              {tags.map((tag) => (
                <a href={`/tags/${tag}/`}>{TAG_LABELS[tag]}</a>
              ))}
              {updatedDate && (
                <span>
                  更新於{" "}
                  <time datetime={dateLabel(updatedDate)}>
                    {dateLabel(updatedDate).replaceAll("-", ".")}
                  </time>
                </span>
              )}
            </div>
          )
        }
        {
          cover && (
            <Image
              class="article-cover"
              src={cover.src}
              alt={cover.alt}
              widths={[640, 960, 1400]}
              sizes="(max-width:760px) 100vw,900px"
              loading="eager"
            />
          )
        }
      </header>
      <div class:list={["reading-grid", { "without-toc": !hasToc }]}>
        {
          hasToc && (
            <aside>
              <TableOfContents headings={headings} />
            </aside>
          )
        }
        <div class="prose" data-pagefind-body><Content /></div>
      </div>
    </article>
  </main>
</Layout>
<script>
  import "../../scripts/article";
</script>
<style>
  .reading-article {
    max-width: 940px;
    margin: auto;
    padding: 50px 0 120px;
  }
  .article-head {
    max-width: 900px;
    margin: 70px auto 60px;
  }
  .eyebrow {
    color: var(--accent);
    font-size: var(--text-meta);
  }
  .article-head h1 {
    margin: 18px 0;
    font: 700 clamp(38px, 5vw, 68px)/1.3 var(--font-sans);
    letter-spacing: -0.02em;
  }
  .standfirst {
    max-width: 720px;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.8;
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 26px;
  }
  .tag-row span,
  .tag-row a {
    padding: 6px 10px;
    border-radius: 4px;
    background: var(--paper-raised);
    font-size: var(--text-meta);
  }
  .tag-row a:hover {
    color: var(--link);
    background: var(--hover);
  }
  .reading-grid {
    display: grid;
    grid-template-columns: 180px minmax(0, 660px);
    gap: 70px;
  }
  @media (max-width: 760px) {
    .reading-article {
      padding: 34px 0 100px;
    }
    .article-head {
      margin: 44px 0 38px;
    }
    .article-head h1 {
      font-size: 38px;
    }
    .standfirst {
      font-size: var(--text-body);
    }
    .reading-grid {
      display: block;
    }
  }
  .reading-grid > aside {
    align-self: stretch;
    min-width: 0;
  }
  .reading-grid.without-toc {
    display: block;
    max-width: 660px;
    margin-inline: auto;
  }
  .article-cover {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 30px;
    border-radius: 8px;
  }
  @media (min-width: 761px) and (max-width: 1060px) {
    .reading-grid {
      grid-template-columns: 150px minmax(0, 660px);
      gap: 30px;
    }
  }
</style>
