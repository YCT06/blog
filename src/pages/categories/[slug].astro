---
import Layout from "../../layouts/Layout.astro";
import { listArticles } from "../../lib/articles";
import {
  CATEGORY_IDS,
  CATEGORY_LABELS,
  type CategoryId,
} from "../../data/taxonomy";

export function getStaticPaths() {
  return CATEGORY_IDS.map((category) => ({
    params: { slug: category },
    props: { category },
  }));
}

interface Props {
  category: CategoryId;
}

const { category } = Astro.props;
const categoryName = CATEGORY_LABELS[category];
const articles = await listArticles({ category });
---

<Layout title={categoryName}>
  <main>
    <a href="/articles/">所有文章</a>
    <h1>{categoryName}</h1>

    {articles.length === 0 && <p>這個分類目前還沒有文章。</p>}

    <ul>
      {
        articles.map((article) => (
          <li>
            <h2>
              <a href={`/articles/${article.data.slug}/`}>
                {article.data.title}
              </a>
            </h2>
            <p>{article.data.description}</p>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
