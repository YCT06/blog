---
import Layout from "../../layouts/Layout.astro";
import PageIntro from "../../components/site/PageIntro.astro";
import CategoryNav from "../../components/taxonomy/CategoryNav.astro";
import ArticleList from "../../components/articles/ArticleList.astro";
import { listArticles } from "../../lib/articles";
import {
  CATEGORY_IDS,
  CATEGORY_LABELS,
  type CategoryId,
} from "../../data/taxonomy";
import { categoryOgImages } from "../../lib/presentation";
export function getStaticPaths() {
  return CATEGORY_IDS.map((category) => ({
    params: { slug: category },
    props: { category },
  }));
}
interface Props {
  category: CategoryId;
}
const { category } = Astro.props;
const allArticles = await listArticles();
const articles = allArticles.filter((a) => a.data.category === category);
---

<Layout title={CATEGORY_LABELS[category]} image={categoryOgImages[category]}
  ><main id="main-content" tabindex="-1" class="archive-page">
    <PageIntro
      title="所有筆記，依脈絡累積。"
      eyebrow="文章總覽"
      description="依分類瀏覽，再用標籤串起跨領域內容。"
      articles={allArticles}
    />
    <CategoryNav current={category} /><ArticleList
      articles={articles}
      title={CATEGORY_LABELS[category]}
      emptyMessage="這個分類目前還沒有文章。"
    />
  </main></Layout
>
<style>
  .archive-page {
    padding-top: 28px;
  }
  @media (max-width: 760px) {
    .archive-page {
      padding-top: 20px;
    }
  }
</style>
