---
import Layout from "../layouts/Layout.astro";
---

<Layout title="搜尋文章"
  ><main id="main-content" tabindex="-1" class="search-page">
    <header class="search-intro">
      <p class="overline">搜尋筆記</p>
      <h1 data-query-title>搜尋文章</h1>
      <span data-search-status role="status" aria-live="polite"></span>
    </header>

    <section class="search-panel" data-search-prompt>
      <span aria-hidden="true">尋</span>
      <h2>輸入關鍵字開始搜尋</h2>
      <p>可搜尋文章標題與內文，支援繁體中文。</p>
      <div>
        <a href="/articles/">瀏覽文章與分類</a><a href="/tags/">查看全部標籤</a>
      </div>
    </section>

    <ul class="search-results" data-search-results hidden></ul>

    <section class="search-panel" data-search-empty hidden>
      <span aria-hidden="true">尋</span>
      <h2>找不到符合的文章</h2>
      <p>可以改從分類或標籤瀏覽，或換個關鍵字再試一次。</p>
      <div>
        <a href="/articles/">瀏覽文章與分類</a><a href="/tags/">查看全部標籤</a>
      </div>
    </section>

    <section class="search-panel" data-search-error hidden>
      <span aria-hidden="true">！</span>
      <h2>搜尋功能暫時無法使用</h2>
      <p>請稍後再試，或改從分類與標籤瀏覽文章。</p>
      <div>
        <a href="/articles/">瀏覽文章與分類</a><a href="/tags/">查看全部標籤</a>
      </div>
    </section>

    <noscript>
      <section class="search-panel">
        <span aria-hidden="true">尋</span>
        <h2>需要 JavaScript 才能搜尋</h2>
        <p>這個瀏覽器已停用 JavaScript，全文搜尋無法運作，請改從分類與標籤瀏覽文章。</p>
        <div>
          <a href="/articles/">瀏覽文章與分類</a><a href="/tags/">查看全部標籤</a>
        </div>
      </section>
    </noscript>
  </main></Layout
>
<script is:inline>
  // is:inline: Astro/Vite must not bundle this script. Vite's dynamic-import
  // preload transform rewrites `import("/pagefind/pagefind.js")` into a
  // `__vitePreload(...)` call it cannot resolve at build time (the file is
  // written by the `pagefind` CLI after `astro build` finishes), leaving a
  // dangling `__VITE_PRELOAD__` reference that throws at runtime. is:inline
  // ships this script untouched, so the dynamic import runs as a plain
  // browser import against the real, already-built /pagefind/pagefind.js.
  (function () {
    var query = new URLSearchParams(location.search).get("q");
    query = query ? query.trim() : "";

    var titleEl = document.querySelector("[data-query-title]");
    var statusEl = document.querySelector("[data-search-status]");
    var headerInput = document.querySelector(".search input");
    var promptEl = document.querySelector("[data-search-prompt]");
    var resultsEl = document.querySelector("[data-search-results]");
    var emptyEl = document.querySelector("[data-search-empty]");
    var errorEl = document.querySelector("[data-search-error]");

    if (query && titleEl) titleEl.textContent = "「" + query + "」的搜尋結果";
    if (query && headerInput) headerInput.value = query;

    function show(section) {
      [promptEl, resultsEl, emptyEl, errorEl].forEach(function (el) {
        if (el) el.hidden = el !== section;
      });
    }

    function renderResults(results) {
      if (!resultsEl) return;
      resultsEl.replaceChildren();
      results.forEach(function (result) {
        var meta = result.meta || {};
        var item = document.createElement("li");

        var time = document.createElement("time");
        time.textContent = meta.date || "";

        var content = document.createElement("div");

        var h3 = document.createElement("h3");
        var link = document.createElement("a");
        link.className = "title";
        link.href = result.url;
        link.textContent = meta.title || result.url;
        h3.append(link);

        var metaRow = document.createElement("p");
        metaRow.className = "meta-row";
        if (meta.category) {
          var categoryEl = document.createElement(
            meta.categoryHref ? "a" : "span",
          );
          if (meta.categoryHref) categoryEl.href = meta.categoryHref;
          categoryEl.className = "category";
          categoryEl.textContent = meta.category;
          metaRow.append(categoryEl);
        }
        (meta.tags ? meta.tags.split("、") : []).forEach(function (tag) {
          var tagEl = document.createElement("span");
          tagEl.className = "tag";
          tagEl.textContent = "#" + tag;
          metaRow.append(tagEl);
        });

        var excerpt = document.createElement("p");
        excerpt.className = "excerpt";
        excerpt.textContent = result.plain_excerpt || meta.description || "";

        content.append(h3, metaRow, excerpt);

        var arrow = document.createElement("b");
        arrow.setAttribute("aria-hidden", "true");
        arrow.textContent = "↗";

        item.append(time, content, arrow);
        resultsEl.append(item);
      });
    }

    async function runSearch() {
      if (!query) {
        show(promptEl);
        return;
      }

      if (statusEl) statusEl.textContent = "搜尋中…";
      show(null);

      try {
        const pagefind = await import("/pagefind/pagefind.js");
        await pagefind.init();
        const search = await pagefind.search(query);
        const results = await Promise.all(
          search.results.map((result) => result.data()),
        );

        if (statusEl)
          statusEl.textContent = results.length
            ? "共找到 " + results.length + " 篇文章"
            : "";

        if (results.length === 0) {
          show(emptyEl);
          return;
        }

        renderResults(results);
        show(resultsEl);
      } catch (error) {
        console.error("Pagefind search failed", error);
        if (statusEl) statusEl.textContent = "";
        show(errorEl);
      }
    }

    runSearch();
  })();
</script>
<style>
  .search-page {
    padding-top: 54px;
  }
  .search-intro {
    min-height: 200px;
    padding: 52px 42px 40px;
    border-bottom: 2px solid var(--line);
  }
  .search-intro h1 {
    overflow-wrap: anywhere;
    margin: 0 0 14px;
    font: 700 clamp(44px, 6vw, 70px)/1.3 var(--font-sans);
  }
  .search-intro > span {
    display: block;
    color: var(--muted);
    font-size: var(--text-meta);
  }
  .search-panel {
    display: grid;
    justify-items: center;
    padding: 90px 20px 50px;
    text-align: center;
  }
  .search-panel > span {
    display: grid;
    place-items: center;
    width: 68px;
    height: 82px;
    color: #fff8eb;
    background: var(--accent);
    font: 700 28px var(--font-sans);
  }
  .search-panel h2 {
    margin: 28px 0 8px;
    font: 700 25px var(--font-sans);
  }
  .search-panel p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-ui);
  }
  .search-panel div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
  }
  .search-panel a {
    padding: 7px 11px;
    border: 1px solid var(--line-soft);
    border-radius: 99px;
    background: transparent;
    font-size: var(--text-ui);
  }
  .search-panel a:hover {
    color: var(--link);
    background: var(--hover);
  }
  /*
    Results are appended via document.createElement in the inline script
    below, so they never receive Astro's scoped data-astro-cid attribute.
    Only .search-results itself (rendered by Astro) carries that attribute;
    everything after it must stay wrapped in :global() to actually match
    those dynamically-created descendants.
  */
  .search-results {
    list-style: none;
    margin: 0;
    padding: 10px 0 0;
  }
  .search-results :global(li) {
    position: relative;
    display: grid;
    grid-template-columns: 92px 1fr 28px;
    gap: 20px;
    align-items: center;
    min-height: 100px;
    padding: 24px 10px;
  }
  .search-results :global(li + li) {
    border-top: 1px solid var(--line-subtle);
  }
  .search-results :global(li:hover),
  .search-results :global(li:focus-within) {
    background: var(--accent-hover);
  }
  .search-results :global(li:focus-within) {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }
  .search-results :global(li > time) {
    color: var(--faint);
    font-size: var(--text-meta);
  }
  .search-results :global(li h3) {
    margin: 0 0 8px;
    font: 600 var(--text-card-title)/1.4 var(--font-sans);
  }
  .search-results :global(li a.title::after) {
    content: "";
    position: absolute;
    inset: 0;
  }
  .search-results :global(li a.title:focus-visible) {
    outline: none;
    text-decoration: underline;
  }
  .search-results :global(li .meta-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    font-size: var(--text-meta);
  }
  .search-results :global(li .category) {
    position: relative;
    z-index: 2;
    padding: 3px 7px;
    border-radius: 2px;
    color: var(--accent-text);
    background: var(--category-surface);
    font-style: normal;
  }
  .search-results :global(li a.category:hover) {
    text-decoration: underline;
  }
  .search-results :global(li .tag) {
    position: relative;
    z-index: 2;
    color: var(--muted);
  }
  .search-results :global(li .excerpt) {
    display: -webkit-box;
    overflow: hidden;
    margin: 8px 0 0;
    color: var(--muted);
    font: var(--text-ui)/1.7 var(--font-sans);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .search-results :global(li > b) {
    justify-self: end;
    color: var(--link);
    font-size: 18px;
  }
  @media (max-width: 760px) {
    .search-intro {
      min-height: 160px;
      padding: 38px 8px 34px;
    }
    .search-intro h1 {
      font-size: 40px;
    }
    .search-results {
      padding: 4px 4px 0;
    }
    .search-results :global(li) {
      grid-template-columns: 1fr 28px;
      gap: 8px;
      padding: 20px 6px;
    }
    .search-results :global(li > time) {
      grid-column: 1/-1;
    }
  }
  @media (max-width: 760px) {
    .search-page {
      padding-top: 20px;
    }
  }
</style>
