---
import Layout from "../layouts/Layout.astro";
import { listArticles } from "../lib/articles";

const latestArticles = (await listArticles()).slice(0, 5);
---

<Layout>
  <main>
    <h1>蔡鎰群的個人筆記</h1>

    <section aria-labelledby="latest-articles">
      <h2 id="latest-articles">最新文章</h2>
      {latestArticles.length === 0 && <p>目前還沒有文章。</p>}

      <ul>
        {
          latestArticles.map((article) => (
            <li>
              <h3>
                <a href={`/articles/${article.data.slug}/`}>
                  {article.data.title}
                </a>
              </h3>
              <p>{article.data.description}</p>
            </li>
          ))
        }
      </ul>

      <a href="/articles/">查看所有文章</a>
    </section>
  </main>
</Layout>
