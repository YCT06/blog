---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/articles/ArticleCard.astro";
import BirdMark from "../components/site/BirdMark.astro";
import { listArticles } from "../lib/articles";
const latestArticles = (await listArticles()).slice(0, 5);
---

<Layout>
  <main id="main-content" tabindex="-1">
    <section class="home-intro" aria-labelledby="home-title">
      <div class="identity">
        <BirdMark />
      </div>
      <div>
        <p class="overline">學習・創作・生活</p><h1 id="home-title">
          記下學習，也收藏生活。
        </h1><p class="lead">程式、繪圖、語言、閱讀與日常的個人筆記。</p>
      </div>
    </section>
    <section class="latest" aria-labelledby="latest-articles">
      <header>
        <h2 id="latest-articles">最新文章</h2><span>近期發布</span>
      </header>
      {
        latestArticles.length ? (
          <ul class="cards">
            {latestArticles.map((article) => (
              <li>
                <ArticleCard article={article} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">目前還沒有文章。</p>
        )
      }
      <div class="latest-more">
        <a class="section-action" href="/articles/">查看全部文章　→</a>
      </div>
    </section>
  </main>
</Layout>
<style>
  .home-intro {
    min-height: 270px;
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 54px;
    align-items: center;
    padding: 40px 42px;
  }
  .identity {
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px 10px 0;
    border-right: 1px solid var(--line-soft);
  }
  .identity :global(.bird-mark) {
    width: 100%;
    max-width: 170px;
  }
  .home-intro h1 {
    margin: 0;
    font: 700 clamp(36px, 4.3vw, 58px)/1.3 var(--font-sans);
    letter-spacing: 0.02em;
  }
  .lead {
    max-width: 600px;
    margin: 15px 0 0;
    color: var(--muted);
    font: var(--text-body)/1.8 var(--font-sans);
  }
  .latest {
    padding-top: 48px;
  }
  .latest > header {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 18px;
    padding-bottom: 16px;
  }
  .latest header h2 {
    margin: 0;
    font: 700 27px var(--font-sans);
  }
  .latest header span {
    color: var(--faint);
    font-size: var(--text-meta);
    letter-spacing: 0.15em;
  }
  .section-action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 0;
    border: 0;
    background: none;
    color: var(--link);
    font-size: var(--text-ui);
  }
  .section-action:hover {
    text-decoration: underline;
  }
  .latest-more {
    display: flex;
    justify-content: flex-end;
    margin-top: 32px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px 26px;
    padding-top: 32px;
  }
  @media (max-width: 760px) {
    .home-intro {
      min-height: 0;
      display: block;
      padding: 34px 10px 38px;
    }
    .identity {
      padding: 0 0 26px;
      border: 0;
    }
    .home-intro h1 {
      font-size: 36px;
      line-height: 1.35;
    }
    .lead {
      font-size: var(--text-body);
    }
    .latest {
      padding-top: 42px;
    }
    .latest-more {
      justify-content: center;
    }
    .latest header span {
      display: none;
    }
    .cards {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-top: 24px;
    }
  }
  .cards {
    list-style: none;
    margin: 0;
    padding-left: 0;
  }
  .cards > li {
    min-width: 0;
  }
  .empty {
    padding: 32px 0;
    color: var(--muted);
  }
</style>
