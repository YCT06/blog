---
import { dateLabel, groupByYear, type Article } from "../../lib/presentation";
import { CATEGORY_LABELS, TAG_LABELS } from "../../data/taxonomy";
interface Props {
  articles: Article[];
  title?: string;
  emptyMessage?: string;
}
const {
  articles,
  title = "全部文章",
  emptyMessage = "目前還沒有文章。",
} = Astro.props;
const groups = groupByYear(articles);
---

<section class="archive-results" aria-label={title}>
  <header>
    <div><h2>{title}</h2><span>{articles.length} 篇文章</span></div><small
      >依發布日期排列</small>
  </header>
  {
    articles.length === 0 && (
      <div class="empty">
        <>
          <p>{emptyMessage}</p>
          <a class="text-link" href="/articles/">
            瀏覽所有文章 →
          </a>
        </>
      </div>
    )
  }
  {
    groups.map(([year, entries]) => (
      <section class="archive-year" aria-label={`${year} 年文章`}>
        <div class="year">
          <>
            <h3>{year}</h3>
            <span>{entries.length} 篇</span>
          </>
        </div>
        <ul class="list">
          {entries.map((article) => (
            <li>
              <time datetime={dateLabel(article.data.pubDate)}>
                {dateLabel(article.data.pubDate).slice(5).replace("-", ".")}
              </time>
              <div>
                <h3>
                  <a class="title" href={`/articles/${article.data.slug}/`}>
                    {article.data.title}
                  </a>
                </h3>
                <p>
                  <a
                    class="category"
                    href={`/categories/${article.data.category}/`}
                  >
                    {CATEGORY_LABELS[article.data.category]}
                  </a>
                  {article.data.tags.map((tag) => (
                    <a class="tag" href={`/tags/${tag}/`}>
                      #{TAG_LABELS[tag]}
                    </a>
                  ))}
                </p>
              </div>
              <b aria-hidden="true">↗</b>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</section>
<style>
  .archive-results > header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    padding-bottom: 17px;
  }
  .archive-results > header div {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .archive-results > header h2 {
    margin: 0;
    font: 700 28px var(--font-sans);
  }
  .archive-results > header span,
  .archive-results > header small {
    color: var(--muted);
    font-size: var(--text-meta);
  }
  .archive-year {
    display: grid;
    grid-template-columns: 125px 1fr;
    gap: 30px;
    padding-top: 34px;
  }
  .year {
    display: grid;
    align-content: start;
    gap: 5px;
    padding-top: 8px;
  }
  .year h3 {
    font: 700 28px var(--font-sans);
  }
  .year span {
    color: var(--muted);
    font-size: var(--text-meta);
  }
  .list li {
    display: grid;
    grid-template-columns: 70px 1fr 28px;
    gap: 24px;
    align-items: center;
    min-height: 120px;
    padding: 26px 14px;
    cursor: pointer;
  }
  .list li:hover,
  .list li:focus-within {
    background: var(--accent-hover);
  }
  .list li + li {
    border-top: 1px solid var(--line-subtle);
  }
  .list time {
    color: var(--faint);
    font-size: var(--text-meta);
  }
  .list li h3 {
    margin: 0 0 10px;
    font: 600 var(--text-card-title)/1.5 var(--font-sans);
  }
  .list li p {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    font-size: var(--text-meta);
  }
  .list li .category {
    padding: 3px 7px;
    border-radius: 2px;
    color: var(--accent-text);
    background: var(--category-surface);
    font-style: normal;
  }
  .list li .tag {
    color: var(--muted);
  }
  .list li > b {
    justify-self: end;
    color: var(--link);
    font-size: 18px;
  }
  @media (max-width: 760px) {
    .archive-results > header small {
      display: none;
    }
    .archive-year {
      display: block;
      padding-top: 26px;
    }
    .year {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 13px;
    }
    .list li {
      grid-template-columns: 1fr 28px;
      gap: 8px;
      padding: 26px 10px;
    }
    .list time {
      grid-column: 1/-1;
    }
    .list li h3 {
      font-size: var(--text-card-title);
    }
  }
  .year h3 {
    margin: 0;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .list li {
    position: relative;
  }
  .title::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .list .category,
  .list .tag {
    position: relative;
    z-index: 2;
  }
  .list a:hover {
    text-decoration: underline;
  }
  .list li:focus-within {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }
  .title:focus-visible {
    outline: none;
    text-decoration: underline;
  }
  .empty {
    padding: 54px 20px;
    text-align: center;
    color: var(--muted);
  }
</style>
