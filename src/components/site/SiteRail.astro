---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "首頁", icon: "home" as const, active: path === "/" },
  {
    href: "/articles/",
    label: "所有文章",
    icon: "articles" as const,
    active: path.startsWith("/articles") || path.startsWith("/categories"),
  },
  {
    href: "/tags/",
    label: "所有標籤",
    icon: "tags" as const,
    active: path.startsWith("/tags"),
  },
  {
    href: "/about/",
    label: "關於本站",
    icon: "about" as const,
    active: path.startsWith("/about"),
  },
];
---

<aside class="rail">
  <nav aria-label="主要導覽">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-label={link.label}
          aria-current={
            link.active ? (path === link.href ? "page" : "true") : undefined
          }
        >
          <>
            <Icon name={link.icon} />
            <small aria-hidden="true">{link.label}</small>
          </>
        </a>
      ))
    }
  </nav>
  <ThemeToggle />
</aside>
<style>
  .rail {
    position: fixed;
    z-index: 30;
    top: 50%;
    right: max(14px, calc((100vw - 1120px) / 2 - 90px));
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 58px;
    padding: 7px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--rail);
    box-shadow: 5px 6px 0 color-mix(in srgb, var(--link) 10%, transparent);
    backdrop-filter: blur(10px);
  }
  .rail nav {
    display: grid;
    gap: 3px;
  }
  .rail a {
    position: relative;
    display: grid;
    place-items: center;
    width: 42px;
    height: 43px;
    padding: 0;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--ink);
  }
  .rail a small {
    position: absolute;
    right: 52px;
    width: max-content;
    padding: 5px 8px;
    border-radius: 6px;
    color: var(--paper);
    background: var(--ink);
    font-size: var(--text-small);
    opacity: 0;
    pointer-events: none;
    transform: translateX(6px);
    transition: 0.18s ease;
  }
  .rail a:hover {
    color: var(--link);
    background: var(--hover);
  }
  .rail a:hover small,
  .rail a:focus-visible small {
    opacity: 1;
    transform: translateX(0);
  }
  .rail a[aria-current] {
    color: var(--on-accent);
    background: var(--accent);
  }
  @media (min-width: 761px) and (max-width: 1240px) {
    .rail {
      right: 14px;
    }
  }
  @media (max-width: 760px) {
    .rail {
      top: auto;
      right: 50%;
      bottom: calc(14px + env(safe-area-inset-bottom, 0px));
      transform: translateX(50%);
      flex-direction: row;
      width: auto;
      padding: 5px;
    }
    .rail nav {
      display: flex;
    }
    .rail a {
      width: 44px;
      height: 44px;
    }
    .rail a small {
      display: none;
    }
  }
</style>
