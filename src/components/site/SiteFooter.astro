---
import { site } from "../../data/site";
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
const contacts = [
  { label: "GitHub", icon: "github" as const },
  { label: "Email", icon: "mail" as const },
].map((contact) => ({ ...contact, href: site.links.find((link) => link.icon === contact.icon)?.href }));
---

<footer class="site-footer">
  <p>
    © {year}{" "}
    {site.author}<br /><a
      class="license"
      href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a>
  </p>
  <div class="footer-built">
    <span>使用</span><b>✦</b><span>與 Astro 打造</span>
  </div>
  <div class="footer-tools">
    {
        <nav aria-label="外部連結">
          {contacts.map((link) => link.href ? (
            <a href={link.href} aria-label={link.label}>
              <Icon name={link.icon} />
            </a>
          ) : (
            <span class="pending-contact" role="link" aria-disabled="true" tabindex="0" aria-label={`${link.label}（尚未設定）`}>
              <Icon name={link.icon} />
            </span>
          ))}
        </nav>
    }
  </div>
</footer>
<style>
  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 32px;
    align-items: center;
    margin-top: 90px;
    padding: 28px 0 15px;
    border-top: 1px solid color-mix(in srgb, var(--line-soft) 55%, transparent);
  }
  .site-footer > p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-small);
  }
  .footer-built {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    font-size: var(--text-small);
  }
  .footer-built b {
    color: var(--accent);
    font-size: 17px;
  }
  .site-footer nav {
    justify-self: end;
    display: flex;
    gap: 7px;
  }
  .site-footer nav a,
  .pending-contact {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
  }
  .site-footer nav a:hover {
    color: var(--link);
    background: var(--hover);
  }
  .site-footer nav :global(svg) {
    width: 16px;
    height: 16px;
  }
  @media (max-width: 760px) {
    .site-footer {
      grid-template-columns: 1fr auto;
      gap: 16px;
    }
    .footer-built {
      grid-column: 1/-1;
      grid-row: 2;
      justify-self: start;
    }
  }
  .footer-tools {
    justify-self: end;
    display: grid;
    justify-items: end;
    gap: 8px;
  }
  .license {
    display: inline-block;
    margin-top: 6px;
  }
  .pending-contact { cursor: default; }
</style>
