---
interface Props {
  title?: string;
  description?: string;
}

const { title = "蔡鎰群的個人筆記", description } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header>
      <nav aria-label="主要導覽">
        <ul>
          <li><a href="/">首頁</a></li>
          <li><a href="/articles/">所有文章</a></li>
          <li><a href="/tags/">所有標籤</a></li>
          <li><a href="/search/">搜尋</a></li>
          <li><a href="/about/">關於本站</a></li>
        </ul>
      </nav>
    </header>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
